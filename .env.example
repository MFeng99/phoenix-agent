# ============================================================
# AgentOS Framework — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Paths use forward slashes (e.g. C:/Users/...).
# Unused optional variables may be left blank.
# ============================================================

# ---- Framework API (required) ----
# Secret key used to authenticate API requests between framework
# components. Generate a random string (e.g. via `openssl rand -hex 32`).
FRAMEWORK_API_KEY=change-me-to-a-random-secret

# ---- Feishu / Lark notifications (optional) ----
# If configured, the framework will send notifications (alerts,
# summaries, etc.) to a Feishu/Lark bot. Leave empty to disable.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---- Chrome path (auto-detected, override below) ----
# Full path to the Chrome/Chromium executable. On most systems the
# launcher auto-detects this during installation, but you can force
# a specific install here.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# ---- Optional overrides ----
# Directory where agent memory/persistent state is stored.
# Defaults to ~/.agent-os/agent-memory when empty.
FRAMEWORK_AGENT_DIR=~/.agent-os/agent-memory

# Chrome DevTools Protocol (CDP) working directory. When empty the
# framework picks a temporary directory automatically.
FRAMEWORK_CDP_DIR=

# Full path to the Qdrant vector-database executable. Required for
# vector-search features. Leave empty if Qdrant is not used or is
# available via PATH.
QDRANT_PATH=C:/qdrant/qdrant.exe
