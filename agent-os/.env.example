# AgentOS Environment Configuration
# Copy this file to .env and fill in your values

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# CDP Browser Port
CHROME_CDP_PORT=9333

# Qdrant Vector Database
QDRANT_URL=http://127.0.0.1:6333

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hermes Web UI Port
HERMES_WEBUI_PORT=8648

# Service Ports
SERVICE_QDRANT=6333
SERVICE_OPENCLAW=18789
SERVICE_HERMES_WEBUI=8648
SERVICE_CHROME_CDP=9333

# Paths
FRAMEWORK_DIR=.
LOG_DIR=~/Desktop/agent-os-logs
MODEL_CACHE_DIR=~/.cache/agent-os/models
