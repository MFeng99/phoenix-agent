# AgentOS Environment Configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Runtime backend
# ---------------------------------------------------------------------------
# Name or absolute path of the executor runtime CLI.
# The installer overwrites this with the actual binary path it resolves.
EXECUTOR_CLI=executor

# Executor gateway base URL
EXECUTOR_GATEWAY_URL=http://127.0.0.1:18789

# ---------------------------------------------------------------------------
# Browser automation (CDP)
# ---------------------------------------------------------------------------
CHROME_CDP_PORT=9333

# Optional: absolute path to the CDP manager script used by the self-healing
# daemon. Defaults to the copy shipped next to healers.py.
# CDP_MANAGER_PATH=

# ---------------------------------------------------------------------------
# Vector memory
# ---------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=~/.cache/agent-os/models

# ---------------------------------------------------------------------------
# Orchestrator
# ---------------------------------------------------------------------------
ORCHESTRATOR_WEBUI_PORT=8648

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
SERVICE_QDRANT=6333
SERVICE_EXECUTOR=18789
SERVICE_ORCHESTRATOR_WEBUI=8648
SERVICE_CHROME_CDP=9333

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
FRAMEWORK_DIR=.
LOG_DIR=~/Desktop/agent-os-logs
